# Generate with: custody-admin init   (production: KMS/HSM-held signing key, OIDC/mTLS at the edge)
CUSTODY_SIGNING_KEY=
CUSTODY_TOKEN_SECRET=
CUSTODY_STORAGE=fs                 # fs | s3
CUSTODY_S3_BUCKET=
CUSTODY_S3_KMS_KEY_ID=
# Optional AI triage enrichment. The workflow is identical with these unset.
CUSTODY_AI_ENABLED=0
CUSTODY_ANTHROPIC_API_KEY=
CUSTODY_AI_MODEL=claude-sonnet-5-5
